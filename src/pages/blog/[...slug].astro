---
import { getEntry } from 'astro:content';
import PostLayout from '../../layouts/PostLayout.astro';
import { calculateReadingTime } from '../../utils/readingTime';

export const prerender = false;

const user = Astro.locals.user;
const previewDraftsEnabled = Astro.cookies.get('previewDrafts')?.value === 'true';
const canViewDrafts = import.meta.env.DEV || (Boolean(user) && previewDraftsEnabled);

const slugParam = Astro.params.slug;
const slug = Array.isArray(slugParam) ? slugParam.join('/') : slugParam;

const post = slug ? await getEntry('blog', slug) : null;

if (!post || (!canViewDrafts && post.data.draft)) {
  return new Response('Not found', { status: 404 });
}

const { Content, headings } = await post.render();
const readingTime = calculateReadingTime(post.body);
---

<PostLayout {...post.data} headings={headings} currentPost={post} readingTime={readingTime}>
  <Content />
</PostLayout>
