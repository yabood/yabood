---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Header from '../../../../components/Header.astro';
import Footer from '../../../../components/Footer.astro';
import Prose from '../../../../components/Prose.astro';

export const prerender = false;

const user = Astro.locals.user;
const previewDraftsEnabled = Astro.cookies.get('previewDrafts')?.value === 'true';
const canViewDrafts = import.meta.env.DEV || (Boolean(user) && previewDraftsEnabled);

const slugParam = Astro.params.slug;
const updateSlugParam = Astro.params.updateSlug;

if (!slugParam || !updateSlugParam) {
  return new Response('Not found', { status: 404 });
}

const projectSlug = slugParam!;
const updateSlugValue = updateSlugParam!;

const allUpdates = await getCollection('updates');
const update = allUpdates.find((entry) => entry.id === updateSlugValue) || null;

if (!update || update.data.project !== projectSlug || (!canViewDrafts && update.data.draft)) {
  return new Response('Not found', { status: 404 });
}

const allProjects = await getCollection('projects');
const project = allProjects.find((p) => p.id === projectSlug) || null;

const sortedUpdates = allUpdates
  .filter(
    (entry) => entry.data.project === update.data.project && (canViewDrafts || !entry.data.draft)
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const currentIndex = sortedUpdates.findIndex((u) => u.id === update.id);
const prevUpdate = currentIndex < sortedUpdates.length - 1 ? sortedUpdates[currentIndex + 1] : null;
const nextUpdate = currentIndex > 0 ? sortedUpdates[currentIndex - 1] : null;

const { Content } = await render(update);

const phaseLabels = {
  idea: 'Idea',
  research: 'Research',
  implementation: 'Implementation',
  release: 'Release',
  iteration: 'Iteration',
  archived: 'Archived',
};

const breadcrumbs = [
  { name: 'Projects', url: '/projects' },
  { name: project?.data.title || update.data.project, url: `/projects/${update.data.project}` },
  { name: update.data.title, url: `/projects/${update.data.project}/updates/${update.id}` },
];
---

<BaseLayout
  title={update.data.title}
  description={update.data.summary}
  type="article"
  publishedDate={update.data.date}
  breadcrumbs={breadcrumbs}
  tags={update.data.tags}>
  <Header />

  <main id="main" class="container mx-auto max-w-3xl px-4 py-12">
    <nav class="mb-8">
      <ol class="flex flex-wrap items-center gap-2 text-sm text-gray-600">
        <li>
          <a href="/projects" class="hover:text-accent">Projects</a>
        </li>
        <li>/</li>
        <li>
          <a href={`/projects/${update.data.project}`} class="hover:text-accent">
            {project?.data.title || update.data.project}
          </a>
        </li>
        <li>/</li>
        <li class="font-medium text-gray-900">
          {update.data.title}
        </li>
      </ol>
    </nav>

    <article>
      <header class="mb-8">
        <div class="mb-4">
          <span class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700">
            {phaseLabels[update.data.phase]}
          </span>
        </div>

        <h1 class="mb-4 text-4xl font-bold tracking-tight text-gray-900 sm:text-5xl">
          {update.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-4 text-sm text-gray-600">
          <time datetime={update.data.date.toISOString()}>
            {
              update.data.date.toLocaleDateString('en-US', {
                month: 'long',
                day: 'numeric',
                year: 'numeric',
              })
            }
          </time>
          {
            update.data.tags.length > 0 && (
              <>
                <span>•</span>
                <div class="flex flex-wrap gap-2">
                  {update.data.tags.map((tag) => (
                    <span class="text-gray-500">{tag}</span>
                  ))}
                </div>
              </>
            )
          }
        </div>

        {
          update.data.summary && (
            <p class="mt-6 text-lg leading-relaxed text-gray-600">{update.data.summary}</p>
          )
        }
      </header>

      <Prose>
        <Content />
      </Prose>
    </article>

    <nav class="mt-12 flex items-center justify-between border-t border-gray-200 pt-8">
      {
        prevUpdate ? (
          <a
            href={`/projects/${update.data.project}/updates/${prevUpdate.id}`}
            class="group flex max-w-xs flex-col">
            <span class="text-sm text-gray-500">← Previous</span>
            <span class="mt-1 font-medium text-gray-900 group-hover:text-accent">
              {prevUpdate.data.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }

      {
        nextUpdate ? (
          <a
            href={`/projects/${update.data.project}/updates/${nextUpdate.id}`}
            class="group flex max-w-xs flex-col text-right">
            <span class="text-sm text-gray-500">Next →</span>
            <span class="mt-1 font-medium text-gray-900 group-hover:text-accent">
              {nextUpdate.data.title}
            </span>
          </a>
        ) : (
          <div />
        )
      }
    </nav>
  </main>

  <Footer />
</BaseLayout>
